DATABASE_URL=postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/NOMBRE_BD?schema=public
# Public base URL of the app (used to build the Google OAuth redirect URI)
APP_URL=http://localhost:3000

# Google OAuth client (Google Cloud Console > Credentials > OAuth client ID, type "Web application").
# Authorized redirect URI: ${APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
